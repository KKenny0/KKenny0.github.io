---
import { site } from "../data/site";
import TopNav from "../components/TopNav.astro";
import "../styles/global.css";

interface Props { title?: string; description?: string; }
const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} · Kenny Ponders` : "Kenny Ponders · AI tools, agent workflows, and forms for thought";
const canonicalUrl = new URL(Astro.url.pathname, site.canonical).toString();
const socialImageUrl = new URL(site.avatar, site.canonical).toString();
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta name="keywords" content={site.keywords} />
  <link rel="canonical" href={canonicalUrl} />
  <title>{pageTitle}</title>
  <link rel="icon" href={site.favicon} type="image/png" />
  <script is:inline>
    (() => {
      try {
        const mode = localStorage.getItem("theme-mode") || "auto";
        const dark = matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.dataset.themeMode = mode;
        document.documentElement.dataset.theme = mode === "auto" ? (dark ? "dark" : "light") : mode;
      } catch {}
    })();
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600&family=Literata:ital,opsz,wght@0,7..72,400;0,7..72,600;1,7..72,500&display=swap" rel="stylesheet" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={socialImageUrl} />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={socialImageUrl} />
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to main content</a>
  <div class="site-frame">
    <TopNav currentPath={Astro.url.pathname} />
    <main id="main-content"><slot /></main>
    <footer class="site-footer">
      <div><strong>Kenny Ponders</strong><span>AI engineer in Shenzhen</span></div>
      <p>Building local-first tools, agent workflows, and forms for thought.</p>
      <nav aria-label="Footer links">
        <a href={site.github_link} target="_blank" rel="noopener">GitHub</a>
        <a href={site.zhihu_link} target="_blank" rel="noopener">Zhihu</a>
        <a href={`mailto:${site.email}`}>Email</a>
        <a href="/support/">Support</a>
      </nav>
    </footer>
  </div>

  <div class="command-palette" data-command-palette hidden>
    <div class="command-dialog" role="dialog" aria-modal="true" aria-labelledby="command-title">
      <div class="command-search">
        <span id="command-title">Maker index</span>
        <input data-command-input type="search" placeholder="Filter projects, notes, and pages" aria-label="Filter site index" />
        <button type="button" data-command-close aria-label="Close site index">Esc</button>
      </div>
      <nav aria-label="Site index">
        <a href="/" data-command-item><span>01</span>Studio<small>Home</small></a>
        <a href="/projects/" data-command-item><span>02</span>Projects<small>Capture · Think · Make</small></a>
        <a href="/notes/" data-command-item><span>03</span>Notes<small>Context · Memory · Agents</small></a>
        <a href="/about/" data-command-item><span>04</span>About<small>Work · Research · CV</small></a>
      </nav>
    </div>
  </div>

  <script>
    const root = document.documentElement;
    const query = matchMedia("(prefers-color-scheme: dark)");
    const themeButton = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
    const modes = ["auto", "light", "dark"] as const;
    type Mode = typeof modes[number];
    const readMode = (): Mode => {
      const value = localStorage.getItem("theme-mode") || root.dataset.themeMode || "auto";
      return modes.includes(value as Mode) ? value as Mode : "auto";
    };
    const applyMode = (mode: Mode, persist = false) => {
      root.dataset.themeMode = mode;
      root.dataset.theme = mode === "auto" ? (query.matches ? "dark" : "light") : mode;
      if (persist) localStorage.setItem("theme-mode", mode);
      if (themeButton) {
        themeButton.textContent = mode[0].toUpperCase() + mode.slice(1);
        themeButton.setAttribute("aria-label", `Theme: ${themeButton.textContent}`);
      }
    };
    applyMode(readMode());
    themeButton?.addEventListener("click", () => {
      const current = readMode();
      applyMode(current === "auto" ? "light" : current === "light" ? "dark" : "auto", true);
    });
    query.addEventListener("change", () => { if (readMode() === "auto") applyMode("auto"); });

    const palette = document.querySelector<HTMLElement>("[data-command-palette]");
    const input = document.querySelector<HTMLInputElement>("[data-command-input]");
    const openPalette = () => { if (palette) { palette.hidden = false; document.body.classList.add("command-open"); input?.focus(); } };
    const closePalette = () => { if (palette) { palette.hidden = true; document.body.classList.remove("command-open"); } };
    document.querySelector("[data-command-open]")?.addEventListener("click", openPalette);
    document.querySelector("[data-command-close]")?.addEventListener("click", closePalette);
    palette?.addEventListener("click", (event) => { if (event.target === palette) closePalette(); });
    input?.addEventListener("input", () => {
      const value = input.value.trim().toLowerCase();
      document.querySelectorAll<HTMLElement>("[data-command-item]").forEach((item) => {
        item.hidden = Boolean(value && !item.innerText.toLowerCase().includes(value));
      });
    });
    document.addEventListener("keydown", (event) => {
      const typing = event.target instanceof HTMLInputElement || event.target instanceof HTMLTextAreaElement;
      if (event.key === "/" && !typing) { event.preventDefault(); palette?.hidden ? openPalette() : closePalette(); }
      if (event.key === "Escape") closePalette();
    });
  </script>
</body>
</html>
