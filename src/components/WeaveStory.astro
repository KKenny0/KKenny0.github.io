---
import PortfolioLayout from '../layouts/PortfolioLayout.astro';
import '../styles/project-story.css';
interface Props { lang: 'en' | 'zh'; }
const { lang } = Astro.props;
const base = lang === 'en' ? '' : '/zh';
const t = (en: string, zh: string) => lang === 'en' ? en : zh;
---
<PortfolioLayout title="weave" lang={lang} page="projects/weave">
<main id="main" class="story-page">
    <section class="story-hero" aria-labelledby="weave-title">
      <div class="story-hero-copy">
        <a class="story-back" href={`${base}/projects/`}>{t("← Projects", "← 项目")}</a>
        <div class="story-hero-meta"><span>{t("02 / Think", "02 / 思考")}</span><span>{t("Research & writing skill", "研究与写作技能")}</span><span>{t("Claude Code + Codex", "Claude Code + Codex")}</span></div>
        <h1 id="weave-title">{t("weave", "weave")}</h1>
        <p class="story-hero-subtitle">{t("Research the question. Write it clearly.", "围绕你的问题，研究并写清楚。")}</p>
      </div>

      <div class="story-hero-aside">
        <p>{t("Start with a question, a few sources, or code. weave researches the gaps around your goal, develops a provisional explanation, and turns it into a focused first draft suited to your readers.", "给一个问题、几份材料或代码，weave 会围绕目标补足证据，形成可修正的解释方向，写成重点清楚、适合读者的初稿。")}</p>
        <div class="story-hero-actions">
          <a class="story-link" href="https://github.com/KKenny0/weave" target="_blank" rel="noopener">{t("Read the repository ↗", "查看代码仓库 ↗")}</a>
          <span class="story-hero-note">{t("Your goal guides the research.", "让目标引导研究")}</span>
        </div>
      </div>

      <div class="story-board">
        <div class="story-board-heading"><span>{t("Research & writing", "研究与写作")}</span><span>{t("one flow, with room to return", "一条可以往返的主线")}</span></div>
        <div class="story-board-flow">
          <div class="story-board-node"><strong>{t("Question & reader goals", "问题与读者目标")}</strong><span>{t("What to explain, and for whom", "要讲清什么，写给谁")}</span></div>
          <span class="story-board-arrow" aria-hidden="true">→</span>
          <div class="story-board-node"><strong>{t("Research the gaps", "围绕缺口研究")}</strong><span>{t("Find the evidence the answer needs", "补足回答所需的证据")}</span></div>
          <span class="story-board-arrow" aria-hidden="true">→</span>
          <div class="story-board-node"><strong>{t("Provisional explanation", "暂定解释方向")}</strong><span>{t("Connect and challenge the evidence", "组织证据，检验解释")}</span></div>
          <span class="story-board-arrow" aria-hidden="true">→</span>
          <div class="story-board-node"><strong>{t("Write", "写作")}</strong><span>{t("Develop mechanisms and examples", "展开机制与例子")}</span></div>
          <span class="story-board-arrow" aria-hidden="true">→</span>
          <div class="story-board-node"><strong>{t("Review against brief & evidence", "对照委托与证据复查")}</strong><span>{t("Check the actual draft", "回读实际成稿")}</span></div>
        </div>
        <p class="story-board-caption">{t("When a problem appears, return to the step it affects. The frame is provisional: evidence can revise it, while the original goal stays in view.", "发现问题时，回到受影响的步骤。取景框是暂定的解释方向，可以被证据修正，但始终要对照原始目标。")}</p>
      </div>
    </section>

    <section class="story-question" aria-labelledby="weave-question-title">
      <span class="story-section-label">{t("01 / The question", "01 / 问题")}</span>
      <div>
        <h2 id="weave-question-title">{t("A readable answer still needs to explain what matters.", "读得顺，还要讲清你关心的事。")}</h2>
        <p>{t("A fluent summary can leave the hard mechanism unexplained, assume knowledge the reader lacks, or smooth over disagreement. Research needs to follow the question far enough to support the explanation.", "流畅的总结可能跳过最难理解的机制，默认读者知道必要背景，或抹平来源之间的分歧。研究需要沿着问题深入，直到证据足以支撑解释。")}</p>
        <p>{t("weave keeps the assignment in view: spend depth on your priorities, supply the reader's missing prerequisites, and make the sources and limits traceable.", "weave 始终对照这次委托：在你关心的地方展开，补上读者需要的前提，并让来源和结论边界可以回查。")}</p>
      </div>
    </section>

    <section class="story-routes" aria-labelledby="weave-examples-title">
      <div class="story-section-intro">
        <span class="story-section-label">{t("02 / In practice", "02 / 实际用途")}</span>
        <div>
          <h2 id="weave-examples-title">{t("Start with what you want to understand.", "从你想弄懂的问题开始。")}</h2>
          <p>{t("These are examples of the same research-and-writing flow. State your question, readers, and materials; the evidence gaps determine the next action.", "这些例子共用同一条研究写作主线。说明问题、读者和材料，接下来的研究动作由证据缺口决定。")}</p>
        </div>
      </div>
      <div class="story-route-list">
        <div class="story-route story-route-heading" aria-hidden="true"><span>{t("No.", "序号")}</span><span>{t("Use", "用途")}</span><span>{t("Starting point", "从哪里开始")}</span><span>{t("What to explain", "要讲清什么")}</span></div>
        <div class="story-route"><strong>{t("01", "01")}</strong><h3>{t("Explain a technology from scratch", "从零讲懂技术")}</h3><p>{t("Research browser use for readers with no prior knowledge.", "为完全不了解这个领域的读者研究 browser use，让人理解 AI 如何操作浏览器。")}</p><p>{t("Explain its principles, evolution, and current approaches through a concrete browser task.", "用具体浏览器任务串起实现原理、技术演进和当前方案。")}</p></div>
        <div class="story-route"><strong>{t("02", "02")}</strong><h3>{t("Study one question across mixed sources", "用混合材料研究同一个问题")}</h3><p>{t("Bring papers, design documents, and a repository to the same question.", "带着同一个问题，结合论文、设计文档与代码仓库。")}</p><p>{t("Connect claims to implementation, retain disagreements, and explain what the combined evidence supports.", "把主张与实现对应起来，保留分歧，说明综合证据能支持什么。")}</p></div>
        <div class="story-route"><strong>{t("03", "03")}</strong><h3>{t("Revisit a draft with new evidence", "判断新材料如何影响已有稿件")}</h3><p>{t("Provide an existing draft and newly available material.", "提供已有稿件和新出现的材料。")}</p><p>{t("Decide whether to add facts, revise the explanation, or develop a separate article.", "判断应当补事实、改解释，还是另写一篇。")}</p></div>
      </div>
    </section>

    <section class="story-gates" aria-labelledby="weave-gates-title">
      <div class="story-section-intro">
        <span class="story-section-label">{t("03 / How it works", "03 / 如何做到")}</span>
        <div>
          <h2 id="weave-gates-title">{t("A frame gives the explanation direction.", "用可修正的取景框组织解释。")}</h2>
          <p>{t("A frame is a provisional explanation that serves your goal. It guides evidence selection, mechanism depth, and boundaries. Evidence can change it; there is no fixed candidate count or required frame-selection step before research begins.", "取景框是服务于用户目标的暂定解释方向，决定证据取舍、机制如何展开，以及结论的边界。证据可以修正它，不必凑够固定数量的候选，也不要求用户在研究前先选框。")}</p>
        </div>
      </div>
      <ol class="story-gate-list">
        <li><span>{t("01", "01")}</span><strong>{t("Keep the goal", "对照目标")}</strong><p>{t("The explanation must address the original priorities at the depth the readers need.", "解释要回应原始重点，并达到目标读者需要的深度。")}</p></li>
        <li><span>{t("02", "02")}</span><strong>{t("Select evidence", "选择证据")}</strong><p>{t("Keep the sources that support or challenge the answer, including contradictions and version limits.", "选择能支撑或挑战回答的材料，保留反证、分歧与版本限制。")}</p></li>
        <li><span>{t("03", "03")}</span><strong>{t("Develop the mechanism", "展开机制")}</strong><p>{t("Connect necessary concepts and concrete examples so the reader can follow the reasoning.", "接通必要概念，用具体例子展开机制，让读者能跟上推理。")}</p></li>
        <li><span>{t("04", "04")}</span><strong>{t("Test the boundary", "检验边界")}</strong><p>{t("Look for conditions or counterexamples that narrow the claim or require a different explanation.", "寻找会缩小结论、推翻解释的条件或反例。")}</p></li>
        <li><span>{t("05", "05")}</span><strong>{t("Revise the frame", "修正取景框")}</strong><p>{t("Return to research when evidence fails, and replace the explanation when needed without silently dropping the user's priorities.", "证据不足就补研究，解释不成立就更换方向，同时保留用户明确关心的问题。")}</p></li>
      </ol>
    </section>

    <section class="story-boundary" aria-labelledby="weave-boundary-title">
      <div class="story-section-intro">
        <span class="story-section-label">{t("04 / Delivery checks", "04 / 交付检查")}</span>
        <div>
          <h2 id="weave-boundary-title">{t("Review the draft against the assignment.", "把成稿放回委托里检查。")}</h2>
          <p>{t("A complete process does not establish draft quality. Review the actual written file against the brief, the reader's prerequisites, and the evidence.", "流程走完不等于初稿达标。交付前回读实际文件，对照委托、读者前提与证据检查。")}</p>
        </div>
      </div>
      <div class="story-boundary-grid">
        <div>
          <span class="story-boundary-mark">{t("What gets checked", "检查什么")}</span>
          <ul>
            <li>{t("Goal fit: priorities, depth, audience, and requested form.", "目标匹配：重点、深度、读者适配与交付形式。")}</li>
            <li>{t("Self-contained explanation: the final article supplies the concepts, mechanisms, and examples its stated readers need.", "解释自足：仅凭成稿及其声明的读者前提，就能跟上核心概念、机制与例子。")}</li>
            <li>{t("Evidence and the delivered file: verify key sources, separate facts from inference, retain counterevidence and version limits, and read back the written file to check its content, format, and links.", "证据与实际产物：复核关键来源，区分事实与推断，保留反证和版本限制；写入后回读实际文件，检查内容、格式与链接。")}</li>
          </ul>
        </div>
        <div>
          <span class="story-boundary-mark">{t("What the checks can establish", "检查能说明什么")}</span>
          <ul>
            <li>{t("Hold-out tests and access-order audits run only when explicitly needed, with the evidence required to support their claims.", "只有明确需要时才启用预留证据（hold-out）检验与访问顺序审计，并提供相应依据。")}</li>
            <li>{t("Model self-review, independent-context reading, and human feedback provide different kinds of evidence; they are reported separately.", "模型自检、独立上下文阅读与真人反馈是不同证据，分别如实报告。")}</li>
            <li>{t("Mechanical checks verify file requirements. They do not establish explanation quality or prove that a human reader understood it.", "机械检查只能核对文件要求，不能证明解释质量，也不能冒充真人理解效果。")}</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="story-cta" aria-labelledby="weave-cta-title">
      <span class="story-section-label">{t("05 / Get started", "05 / 开始使用")}</span>
      <div>
        <h2 id="weave-cta-title">{t("Bring a question you want to understand.", "带来一个你想弄懂的问题。")}</h2>
        <p>{t("Install with Node.js and npm, then tell weave what to research, who it is for, and what you want to receive.", "通过 Node.js 和 npm 安装，再告诉 weave 要研究什么、写给谁，以及希望得到怎样的产物。")}</p>
        <pre class="weave-install" aria-label={t("Install weave", "安装 weave")}><code>npx skills add KKenny0/weave --skill weave -g -y</code></pre>
        <div class="story-cta-links">
          <a class="story-link" href="https://github.com/KKenny0/weave" target="_blank" rel="noopener">{t("Open weave on GitHub ↗", "在 GitHub 查看 weave ↗")}</a>
          <a class="story-link" href="https://github.com/KKenny0/weave/releases/tag/v2.0.0" target="_blank" rel="noopener">{t("v2.0.0 release ↗", "v2.0.0 版本说明 ↗")}</a>
          <a class="story-link" href="https://github.com/KKenny0/weave/blob/main/MIGRATION.md" target="_blank" rel="noopener">{t("Migration guide ↗", "迁移说明 ↗")}</a>
          <a class="story-link story-link--quiet" href={`${base}/projects/`}>{t("Back to the project index ↗", "返回项目列表 ↗")}</a>
        </div>
      </div>
    </section>
  </main>
</PortfolioLayout>

<style>
  .weave-install { min-width: 0; max-width: 100%; margin-top: 20px; padding: 16px; background: var(--soft); color: var(--ink); white-space: pre-wrap; overflow-wrap: anywhere; overflow-x: auto; }
  .weave-install code { font: 14px/1.6 var(--mono); }
</style>
