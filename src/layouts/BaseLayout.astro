---
import { site } from "../data/site";
import ProfilePanel from "../components/ProfilePanel.astro";
import TopNav from "../components/TopNav.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  page?: string;
}

const { title = "Home", page = "" } = Astro.props;
const pageTitle = page ? `${title} — ${site.title}` : `${site.title} | ${site.affiliation}`;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={site.description} />
  <meta name="keywords" content={site.keywords} />
  <link rel="canonical" href={site.canonical} />
  <title>{pageTitle}</title>

  <link rel="icon" media="(prefers-color-scheme:dark)" href={site.favicon_dark} type="image/png" />
  <link rel="icon" media="(prefers-color-scheme:light)" href={site.favicon} type="image/png" />

  <!-- Theme init (before paint) -->
  <script is:inline>
    (function () {
      try {
        var mode = localStorage.getItem("theme-mode") || "auto";
        if (mode !== "auto" && mode !== "light" && mode !== "dark") mode = "auto";
        var prefersDark = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.dataset.themeMode = mode;
        document.documentElement.dataset.theme = mode === "auto" ? (prefersDark ? "dark" : "light") : mode;
      } catch (e) {}
    })();
  </script>

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,500;0,700;1,400&display=swap" rel="stylesheet" />

  <!-- Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/academicons/1.8.6/css/academicons.min.css" crossorigin="anonymous" />

  <!-- SEO -->
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={site.description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={site.canonical} />
  <meta property="og:image" content={site.avatar} />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={site.description} />
  <meta name="twitter:image" content={site.avatar} />
</head>
<body>
  <main class="page-shell" aria-label={page ? `${title} — ${site.title}` : `${site.title} personal homepage`}>
    <div class="wrapper">
      <ProfilePanel />
      <section class="content-panel">
        <TopNav currentPath={Astro.url.pathname} />
        <div class={page ? "subpage-content" : ""} data-page={page || undefined}>
          <slot />
        </div>
        <footer class="page-footer"></footer>
      </section>
    </div>
  </main>

  <script>
    // Theme toggle: auto -> light -> dark -> auto
    const root = document.documentElement;
    const themeQuery = matchMedia("(prefers-color-scheme: dark)");
    const storageKey = "theme-mode";
    const themeModes = ["auto", "light", "dark"] as const;
    type ThemeMode = (typeof themeModes)[number];

    const isThemeMode = (mode: string | undefined): mode is ThemeMode =>
      Boolean(mode && themeModes.includes(mode as ThemeMode));

    const readStoredMode = (): ThemeMode => {
      const stored = localStorage.getItem(storageKey) || root.dataset.themeMode;
      return isThemeMode(stored || undefined) ? stored as ThemeMode : "auto";
    };

    const resolvedTheme = (mode: ThemeMode) =>
      mode === "auto" ? (themeQuery.matches ? "dark" : "light") : mode;

    const toggle = document.querySelector("[data-theme-toggle]");
    const lightIcon = document.querySelector<HTMLLinkElement>('link[rel="icon"][media="(prefers-color-scheme:light)"]');
    const darkIcon = document.querySelector<HTMLLinkElement>('link[rel="icon"][media="(prefers-color-scheme:dark)"]');

    const syncFavicon = () => {
      if (!lightIcon || !darkIcon) return;
      const isDark = root.dataset.theme === "dark";
      lightIcon.disabled = isDark;
      darkIcon.disabled = !isDark;
    };

    const updateLabel = (mode: ThemeMode) => {
      if (!(toggle instanceof HTMLButtonElement)) return;

      const icons: Record<ThemeMode, string> = {
        auto: "fa-solid fa-circle-half-stroke",
        light: "fa-regular fa-sun",
        dark: "fa-regular fa-moon",
      };
      const labels: Record<ThemeMode, string> = {
        auto: "Auto",
        light: "Light",
        dark: "Dark",
      };
      const icon = toggle.querySelector("i");
      const label = toggle.querySelector("span");
      if (icon) icon.className = icons[mode];
      if (label) label.textContent = labels[mode];
      toggle.setAttribute("aria-label", `Theme: ${labels[mode]}`);
    };

    const applyTheme = (mode: ThemeMode, persist = false) => {
      root.dataset.themeMode = mode;
      root.dataset.theme = resolvedTheme(mode);
      if (persist) localStorage.setItem(storageKey, mode);
      updateLabel(mode);
      syncFavicon();
    };

    applyTheme(readStoredMode());

    if (toggle instanceof HTMLButtonElement) {
      toggle.addEventListener("click", () => {
        const current = readStoredMode();
        const next: ThemeMode = current === "auto" ? "light" : current === "light" ? "dark" : "auto";
        applyTheme(next, true);
      });
    }

    themeQuery.addEventListener("change", () => {
      const current = readStoredMode();
      if (current === "auto") applyTheme("auto");
    });
  </script>
</body>
</html>
