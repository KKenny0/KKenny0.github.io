---
import {site} from '../data/site';
import ThemeHead from '../components/ThemeHead.astro';
import '../styles/space.css';
import '../styles/proto-workbench.css';
import '../styles/collage-inner.css';
import {protoTitle} from '../lib/proto-routes';
const {lang,route,space='prototype'}=Astro.props;
const title=protoTitle(route,lang);
const description=lang==='zh'
  ?'全站工作台原型：以四个角色、真实作品与观察线索浏览 Kenny Wu 的项目、笔记、关于与支持页。'
  :'Full-site workbench prototype: browse Kenny Wu’s projects, notes, about and support pages through four roles and real work.';
---
<!doctype html>
<html lang={lang==='zh'?'zh-CN':'en'}>
  <head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width,initial-scale=1"/>
    <meta name="robots" content="noindex"/>
    <meta name="color-scheme" content="light dark"/>
    <title>{title} · 原型 Prototype</title>
    <meta name="description" content={description}/>
    <link rel="icon" href={site.favicon}/>
    <link rel="preload" href="/assets/space/JetBrainsMono.woff2" as="font" type="font/woff2" crossorigin/>
    <ThemeHead/>
  </head>
  <body>
    <slot/>
    <noscript><nav class="static-options" aria-label={lang==='zh'?'原型页面':'Prototype pages'}>
      <a href={`${lang==='zh'?'/zh':''}/${space}/projects/`}>{lang==='zh'?'项目':'Projects'}</a>
      <a href={`${lang==='zh'?'/zh':''}/${space}/notes/`}>{lang==='zh'?'笔记':'Notes'}</a>
      <a href={`${lang==='zh'?'/zh':''}/${space}/about/`}>{lang==='zh'?'关于':'About'}</a>
      <a href={`${lang==='zh'?'/zh':''}/${space}/support/`}>{lang==='zh'?'支持':'Support'}</a>
      <a href={`${lang==='zh'?'/zh':''}/${space}/projects/tracework/`}>Tracework</a>
      <a href={`${lang==='zh'?'/zh':''}/${space}/projects/weave/`}>weave</a>
    </nav></noscript>
  </body>
</html>
