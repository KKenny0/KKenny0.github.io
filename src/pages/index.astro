          <path d="M636 80 C676 48 725 64 746 96 S780 136 836 112" />
        </g>
        <g class="line-drawing">
          <path d="M22 116 C22 64 55 42 92 43 C130 44 158 68 158 118" />
          <path d="M27 108 C4 114 5 154 30 160 C45 154 47 113 27 108 Z" />
          <path d="M152 108 C176 114 176 154 151 160 C135 154 134 113 152 108 Z" />
          <path d="M36 82 C55 58 121 59 145 84" />
