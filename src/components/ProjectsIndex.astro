---
import { activeProjects, archivedProjects, githubSnapshot, projects } from '../data/projects';
interface Props { lang: 'en' | 'zh' }
const { lang } = Astro.props;
const english = lang === 'en';
const t = (en: string, zh: string) => english ? en : zh;
const base = english ? '' : '/zh';
const featured = ['videowipe', 'obsidian-kami'].map(slug => projects.find(project => project.slug === slug)!);
const categories = [['all','All','全部'],['capture','Capture','信息收集'],['think','Think','Agent 协作'],['make','Make','内容创作'],['research','Research','研究实验']];
const date = (value: string) => new Intl.DateTimeFormat('sv-SE', { timeZone: 'Asia/Shanghai', year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date(value));
---
<main id="main" data-screen-label={t('Projects · Project index','Projects · 项目索引')}>
<section class="page-heading"><p class="eyebrow">PROJECTS / TOOLS & EXPERIMENTS</p><h1>{t('Ideas, made tangible.', "想法，落在作品里。")}</h1><p>{t('These are tools and public experiments I build independently. For professional delivery work, see', "这里是我独立制作的工具与公开实验。工作中的交付案例，可以在")} <a class="blue" href={`${base}/about/#experience`}>About</a>{t('.', ' 经历。')}</p></section>
<section class="featured-grid" aria-label={t('Featured projects','代表项目')}>
{featured.map(project => <article class="featured-item"><a href={`#${project.slug}`}><figure class="preview"><img src={project.focus!.src} alt={t(project.focus!.alt,project.focus!.altZh)} loading="lazy" /></figure><h2>{project.name} ↗</h2><p>{t(project.thesis,project.thesisZh)}</p></a><div class="links"><a href={`#${project.slug}`}>{t('Explore project','展开项目')} ↓</a><a href={project.url} target="_blank" rel="noopener noreferrer">GitHub ↗</a></div></article>)}
</section>
<div class="stats-strip"><span><strong>{githubSnapshot.publicRepos}</strong> {t('Public repositories','公开仓库')}</span><span><strong>{githubSnapshot.stars}</strong> Stars</span><span><strong>{githubSnapshot.forks}</strong> Forks</span><span><strong>{githubSnapshot.followers}</strong> {t('Followers','关注者')}</span><span class="caption">GitHub {t('snapshot','快照')} · <time datetime={githubSnapshot.date}>{githubSnapshot.date}</time></span></div>
<p class="caption">{t(`Stars / forks cover ${githubSnapshot.ownedRepos} non-fork public repositories. The index contains ${activeProjects.length} active and ${archivedProjects.length} archived projects, excluding profile, configuration, and this website’s repositories.`,`Stars / Forks 统计 ${githubSnapshot.ownedRepos} 个非 fork 公开仓库；项目索引保留 ${activeProjects.length} 个活跃、${archivedProjects.length} 个归档项目，排除个人简介、配置与本站仓库。`)}</p>
<section class="repository-index" aria-labelledby="index-title">
<div class="section-head"><div><p class="label">REPOSITORY INDEX</p><h2 id="index-title">{t('Repository index','项目索引')}</h2></div><a href="https://github.com/KKenny0?tab=repositories" target="_blank" rel="noopener noreferrer">GitHub ↗</a></div>
<div class="filter-bar"><div class="filters" role="group" aria-label={t('Filter by practice','按实践方向筛选')}>{categories.map(([id,en,zh]) => <button type="button" data-filter={id} aria-pressed={String(id === 'all')}>{t(en,zh)}</button>)}</div><label class="sort" for="sort">{t('Sort by','排序')}<select id="sort"><option value="stars">{t('Stars','Stars 从高到低')}</option><option value="recent">{t('Last pushed','最近推送')}</option></select></label></div>
<p class="collection-status" id="project-count" role="status">{t(`${activeProjects.length} active projects · ${archivedProjects.length} archived`,`当前筛选：${activeProjects.length} 个活跃项目 · ${archivedProjects.length} 个归档项目`)}</p>
{[activeProjects, archivedProjects].map((group, index) => {
const archived = index === 1;
const Container = archived ? 'details' : 'div';
return <Container class={archived ? 'archive-group' : undefined} id={archived ? 'project-archive' : 'project-active'}>
{archived && <summary>{t('Archived projects','归档项目')} · <span id="archive-count">{group.length}</span></summary>}
<div id={archived ? 'archive-items' : 'project-items'} data-project-list={archived ? 'archive' : 'active'}>{group.map(project => <details class="project" id={project.slug} data-category={project.practice} data-stars={project.stars} data-forks={project.forks} data-updated={project.pushedAt} data-archived={String(project.archived)} data-name={project.name}>
<summary><div><strong>{project.name}</strong><p>{t(project.thesis,project.thesisZh)}</p></div><span class="stars" aria-label={t(`${project.stars} stars`,`${project.stars} 个 Star`)}>☆ {project.stars}</span><span class="plus" aria-hidden="true">＋</span></summary>
<div class="project-body"><div class="project-meta"><span class={project.language ? undefined : "project-state"}>{project.language ?? t('Not specified','未标注语言')}</span><span class="project-updated">{t('Last pushed','最近推送')} <time datetime={project.pushedAt}>{date(project.pushedAt)}</time></span><span>{project.forks} forks</span>{project.archived && <span class="project-state">{t('Archived','已归档')}</span>}</div><p>{t(project.description,project.descriptionZh)}</p>
{project.focus ? <><img src={project.focus.src} alt={t(project.focus.alt,project.focus.altZh)} loading="lazy" /><p class="caption">{t(project.focus.caption,project.focus.captionZh)}</p></> : <p class="empty-preview">{t('No public preview for this project. See the repository for documentation and examples.','这个项目暂无公开预览，源代码与说明可在 GitHub 查看。')}</p>}
<div class="links"><a href={project.url} target="_blank" rel="noopener noreferrer">{t('Source code','源代码')} ↗</a>{project.homepage && project.homepage !== project.url && <a href={project.homepage} target="_blank" rel="noopener noreferrer">{t('Visit project','访问项目')} ↗</a>}{project.detailUrl && <a href={project.detailUrl}>{t('Project story','项目介绍')} ↗</a>}</div>
</div></details>)}</div></Container>;
})}
</section>
<section class="contact"><div><p class="label">LET’S WORK TOGETHER</p><h2>{t('Have an AI project to move forward?','有一个 AI 项目想推进？')}</h2><p>{t('Let’s discuss the technical approach, engineering delivery, quality, and reliability.','可以从技术方案聊起，一起梳理工程落地、质量与稳定性。')}</p></div><a href="mailto:jdlow@live.cn">jdlow@live.cn <span aria-hidden="true">↗</span></a></section>
</main>
