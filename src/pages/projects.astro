---
import BaseLayout from "../layouts/BaseLayout.astro";
import { projects } from "../data/projects";
const labels = {capture:"让线索留下来",think:"和 Agent 一起思考",make:"给想法一种形状"};
---
<BaseLayout title="工具架">
<section class="inner-heading">
<div>
<span class="eyebrow">THE TOOL SHELF</span>
<h1>每件工具，<br>始于一个<span class="ink-word">问题。</span>
</h1>
<p>打开看看：它在解决什么，又留下了怎样的作品。</p>
</div>
<img src="/assets/img/practices/walk.png" alt="Kenny 的散步插画" width="1254" height="1254">
</section>
<section class="collection section" aria-label="项目集合">
<div class="filter-bar" role="group" aria-label="按问题筛选项目">
<button data-filter="all" aria-pressed="true">全部工具</button>
<button data-filter="capture" aria-pressed="false">让线索留下来</button>
<button data-filter="think" aria-pressed="false">和 Agent 一起思考</button>
<button data-filter="make" aria-pressed="false">给想法一种形状</button>
</div>
<p class="small-status" id="collection-count" role="status">
</p>
<div class="shelf">{projects.map(project => <details class="shelf-item" id={project.slug} data-entry data-category={project.practice}>
<summary>
<span class="eyebrow">{labels[project.practice]}</span>
<span class="project-name">{project.name}</span>
<span class="project-thesis">{project.thesis}</span>
<span class="open-hint">展开工具档案 <span aria-hidden="true">＋</span>
</span>
</summary>
<div class="project-detail">{project.image && <img class="project-art" src={project.image} alt={`${project.name} 项目展示图`} loading="lazy" />}<h3>它在解决什么</h3>
<p>{project.problem}</p>
<h3>已有的实现</h3>
<p>{project.proof}</p>
<div class="detail-links">{project.slug === 'clipplane' && <a class="primary" href="/#playground">动手收集一句话 →</a>}{project.detailUrl && <a href={project.detailUrl}>阅读项目介绍 →</a>}<a href={project.url} target="_blank" rel="noopener noreferrer">进入项目仓库 ↗</a>
<a href={project.practice === 'make' ? '/notes/' : `/notes/?topic=${project.practice === 'capture' ? 'memory' : 'agents'}`}>翻翻研究笔记 →</a>
</div>
</div>
</details>)}</div>
<p class="editor-note">最新进展与安装说明，请查看各项目仓库。</p>
</section>
<aside class="next-room">
<span>工具背后的想法</span>
<a href="/notes/">去笔记本里接着翻 →</a>
</aside>
</BaseLayout>
