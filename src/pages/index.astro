---
import BaseLayout from "../layouts/BaseLayout.astro";
import { projects } from "../data/projects";
import { writings } from "../data/writings";
---

<BaseLayout>
  <div class="intro-hero">
    <div class="hero-copy">
      <h2 class="hero-title">Language machines, agent workflows, and tools for thought.</h2>
      <span class="title-rule" aria-hidden="true"></span>
    </div>

    <div class="line-garden" aria-label="Line art about music, movement, coffee, food, walking, and the sea">
      <svg viewBox="0 0 900 270" role="img">
        <title>Continuous line illustration of music, yoga, coffee, food, walking, and the sea</title>
        <g class="line-drawing guide">
