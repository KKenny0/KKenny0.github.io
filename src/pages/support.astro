---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
---

<BaseLayout title="Support" page="support">
  <h1 class="subpage-title">Support open source</h1>
  <p class="subpage-lead">
    If my tools save you time or help you think more clearly, support helps me keep them maintained, documented, and useful.
  </p>

  <section class="support-section" aria-labelledby="china-support">
    <div class="support-section-header">
      <span class="support-kicker">China</span>
      <h2 id="china-support">Scan to support directly</h2>
      <p lang="zh-CN">如果你在国内，微信或支付宝是最稳定的支持方式。</p>
    </div>

    <div class="payment-grid">
      <article class="payment-card">
        <div class="payment-card-copy">
          <span class="platform-tag">
            <span class="platform-dot alipay" aria-hidden="true"></span>
            Alipay
          </span>
          <h3>支付宝</h3>
          <p lang="zh-CN">打开支付宝扫一扫，支持 Kenny 继续维护开源工具。</p>
        </div>
        <figure class="payment-qr-frame">
          <img
            src="/assets/img/support/alipay-qr.png"
            alt="Alipay payment QR code for Kenny Wu"
            width="720"
            height="720"
            class="payment-qr"
          />
        </figure>
      </article>

      <article class="payment-card">
        <div class="payment-card-copy">
          <span class="platform-tag">
            <span class="platform-dot wechat" aria-hidden="true"></span>
            WeChat Pay
          </span>
          <h3>微信支付</h3>
          <p lang="zh-CN">打开微信扫一扫，用你习惯的方式支持这些小工具。</p>
        </div>
        <figure class="payment-qr-frame">
          <img
            src="/assets/img/support/wechat-qr.png"
            alt="WeChat Pay QR code for Kenny Wu"
            width="720"
            height="720"
            class="payment-qr"
          />
        </figure>
      </article>
    </div>
  </section>

  <section class="support-section" aria-labelledby="international-support">
    <div class="support-section-header">
      <span class="support-kicker">International</span>
      <h2 id="international-support">GitHub Sponsors</h2>
      <p>GitHub Sponsors is the planned route for overseas users. The profile will be linked here after GitHub approval.</p>
    </div>

    <div class="sponsor-panel">
      <div>
        <span class="platform-tag">
          <i class="fab fa-github" aria-hidden="true"></i>
          GitHub Sponsors
        </span>
        <strong>{site.github_sponsors_live ? "Open for sponsorship" : "Opening after approval"}</strong>
        <p>
          Until the sponsor profile is live, this page is the stable support link for GitHub repositories.
        </p>
      </div>
      {site.github_sponsors_live ? (
        <a class="support-action" href={site.github_sponsors_link} target="_blank" rel="noopener">
          Sponsor on GitHub
          <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
        </a>
      ) : (
        <span class="support-action inactive">Coming soon</span>
      )}
    </div>
  </section>

  <section class="support-section" aria-labelledby="other-support">
    <div class="support-section-header">
      <span class="support-kicker">Non-financial</span>
      <h2 id="other-support">Other ways to help</h2>
    </div>

    <ul class="support-list">
      <li>Star the projects you use so other people can find them.</li>
      <li>Open focused issues with real use cases, screenshots, or logs.</li>
      <li>Share the tools with people who build with agents, language systems, or knowledge workflows.</li>
    </ul>
  </section>
</BaseLayout>
