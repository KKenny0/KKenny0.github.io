---
interface Props { currentPath: string; }
const { currentPath } = Astro.props;
const navItems = [
  { href: "/projects/", label: "Projects" },
  { href: "/notes/", label: "Notes" },
  { href: "/about/", label: "About" },
];
---

<header class="site-masthead">
  <a class="site-identity" href="/" aria-label="Kenny Ponders home">
    <span>Kenny Ponders</span>
    <small lang="zh">肯玩 AI</small>
  </a>
  <nav class="primary-nav" aria-label="Primary navigation">
    {navItems.map((item) => (
      <a href={item.href} class={currentPath.startsWith(item.href) ? "active" : undefined}>{item.label}</a>
    ))}
  </nav>
  <div class="masthead-actions">
    <button class="text-control index-trigger" type="button" data-command-open aria-label="Open site index">
      Index <kbd>/</kbd>
    </button>
    <button class="text-control theme-toggle" type="button" data-theme-toggle aria-label="Theme: Auto">Auto</button>
  </div>
</header>
