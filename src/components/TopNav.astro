---
import { site } from "../data/site";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const navItems = [
  { href: "/", label: "About", match: "/" },
  { href: "/work/", label: "Work", match: "/work/" },
  { href: "/open-source/", label: "Open Source", match: "/open-source/" },
  { href: "/writings/", label: "Writings", match: "/writings/" },
  { href: "/background/", label: "Background", match: "/background/" },
];
---

<nav class="top-nav" aria-label="Primary navigation">
  <div>
    {navItems.map((item) => (
      <a href={item.href} class={currentPath === item.match ? "active" : undefined}>
        {item.label}
      </a>
    ))}
  </div>
  <div class="nav-actions">
    <button class="nav-btn theme-toggle" type="button" data-theme-toggle aria-label="Theme: Auto">
      <i class="fa-solid fa-circle-half-stroke" aria-hidden="true"></i>
      <span>Auto</span>
    </button>
    {site.cv_link && (
      <a class="nav-btn resume-link" href={site.cv_link}>
        Resume
        <i class="fa-solid fa-arrow-down" aria-hidden="true"></i>
      </a>
    )}
  </div>
</nav>
