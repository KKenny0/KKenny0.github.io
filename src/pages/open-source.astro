---
import BaseLayout from "../layouts/BaseLayout.astro";
import { projects } from "../data/projects";
import { site } from "../data/site";
---

<BaseLayout title="Open Source" page="open-source">
  <h1 class="subpage-title">Open Source</h1>
  <p class="subpage-lead">Tools I build in the open. Small, sharp, and useful.</p>

  <div class="project-grid">
    {projects.highlight.map((project, i) => (
      <article class={`project-card${i === 0 ? " hero-card" : ""}`}>
        <div class="project-header">
          <a href={project.url} class="project-title" target="_blank" rel="noopener">{project.name}</a>
          <span class="project-stars">
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.751.751 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z"></path>
            </svg>
            {project.stars}
          </span>
        </div>
        <p class="project-description">{project.description}</p>
        <div class="project-meta">
          <span class="project-language">
            <span class={`lang-dot lang-${project.language.toLowerCase()}`}></span>
            {project.language}
          </span>
          {project.updated && (
            <span class="project-updated">Updated {new Date(project.updated).toLocaleDateString("en-US", { month: "short", year: "numeric" })}</span>
          )}
        </div>
      </article>
    ))}
  </div>

  <div class="contribution-strip">
    <strong>Kotaemon Contributor</strong>
    <span>Top contributor experience in an open-source RAG document chat project, alongside tools such as Open-OmniSearch and GraphRAG visualization work.</span>
  </div>

  <div class="support-strip">
    <strong>Support the work</strong>
    <span>Stars, issues, sharing, and sponsorship all help these tools keep moving.</span>
    <a class="row-action" href={site.support_link}>Support <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
  </div>
</BaseLayout>
