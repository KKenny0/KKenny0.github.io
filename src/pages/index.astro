          <path d="M177 144 C162 132 188 118 172 104" />
        </g>
        <g class="line-drawing">
          <path d="M320 78 C334 82 340 96 333 110 C325 124 306 123 299 110 C293 96 302 81 320 78 Z" />
          <path d="M311 113 C318 132 329 148 348 162" />
          <path d="M316 116 C308 91 301 63 300 34" />
          <path d="M300 34 C298 24 304 17 312 12" />
          <path d="M323 123 C342 136 365 146 389 153" />
          <path d="M348 162 C316 176 282 188 246 192" />
          <path d="M246 192 C263 194 278 200 292 210" />
          <path d="M350 163 C374 185 410 193 450 188" />
          <path d="M246 207 C306 207 376 207 458 207" />
        </g>
        <g class="line-drawing">
          <path d="M492 172 C499 142 556 141 566 172 C554 196 504 197 492 172 Z" />
          <path d="M501 160 C520 174 542 174 561 160" />
          <path d="M496 176 C516 190 544 190 565 176" />
          <path d="M510 151 C519 144 531 145 539 151" />
          <path d="M520 141 C525 135 535 136 540 142" />
          <path d="M534 140 C541 133 552 135 557 144" />
          <path d="M516 127 L553 91" />
          <path d="M538 130 L576 98" />
        </g>
        <g class="line-drawing">
          <path d="M674 58 C658 61 649 76 653 92 C657 108 676 115 690 105 C704 94 700 66 680 61" />
          <path d="M662 61 C656 53 664 46 674 49" />
          <path d="M685 62 C697 58 705 64 701 75" />
          <path d="M664 111 C656 136 653 158 663 181" />
          <path d="M687 113 C699 135 704 157 699 181" />
          <path d="M666 116 C650 130 636 147 628 169" />
          <path d="M689 117 C711 127 732 142 748 162" />
