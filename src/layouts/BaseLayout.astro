---
import { site } from "../data/site";
import { projects } from "../data/projects";
import { writings } from "../data/writings";
import "../styles/personal-space.css";
interface Props { title?: string; description?: string; }
const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} · Kenny Ponders` : "Kenny Ponders · 留一点空间，给思考";
const canonicalUrl = new URL(Astro.url.pathname, site.canonical).toString();
const socialImageUrl = new URL(site.avatar, site.canonical).toString();
const navItems = [{href:'/',label:'Studio'},{href:'/projects/',label:'Projects'},{href:'/notes/',label:'Notes'},{href:'/about/',label:'About'}];
const searchItems = [...navItems.map(item=>({url:item.href,title:item.label})), {url:'/support/',title:'Support 支持创作'}, ...projects.map(p=>({url:`/projects/#${p.slug}`,title:`${p.name} ${p.thesis}`})), ...writings.articles.map(n=>({url:`/notes/#note-${n.id}`,title:n.title}))];
---
<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="description" content={description} />
<meta name="keywords" content={site.keywords} />
<link rel="canonical" href={canonicalUrl} />
<title>{pageTitle}</title>
<link rel="icon" href={site.favicon} type="image/png" />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={socialImageUrl} />
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImageUrl} />
<script is:inline>
(() => { let dark = matchMedia('(prefers-color-scheme: dark)').matches;
try { const stored = localStorage.getItem('kenny-space-theme') || localStorage.getItem('theme-mode'); if (stored === 'dark' || stored === 'light') dark = stored === 'dark'; } catch {}
document.documentElement.dataset.theme = dark ? 'dark' : 'light'; })();
</script>
</head>
<body>
<a class="skip" href="#main">跳到主要内容</a>
<div class="frame">
<header class="masthead">
<a class="identity" href="/">
<span class="glasses" aria-hidden="true">◎—◎</span> Kenny Ponders<span class="identity-cn">肯玩 AI</span>
</a>
<nav aria-label="主导航">{navItems.map(item => <a href={item.href} aria-current={Astro.url.pathname === item.href || (item.href !== '/' && Astro.url.pathname.startsWith(item.href)) ? 'page' : undefined}>{item.label}</a>)}</nav>
<div class="nav-tools">
<button class="search-open" data-open="search-dialog" type="button" aria-label="搜索全站">搜索 <kbd>/</kbd>
</button>
<button class="theme" id="theme" type="button" aria-label="切换到深色外观" aria-pressed="false">灯亮着 <span aria-hidden="true">◐</span>
</button>
</div>
</header>
<main id="main">
<slot />
</main>
<footer>
<div>
<strong>Kenny Ponders</strong>
<p>保持好奇，也留一点空白。</p>
</div>
<div class="footer-links">
<a href="/">回到工作桌</a>
<a href={site.github_link} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
<a href={site.zhihu_link} target="_blank" rel="noopener noreferrer">知乎 ↗</a>
<a href="/support/">支持创作</a>
<a href={`mailto:${site.email}`}>写封信 ↗</a>
</div>
</footer>
</div>
<dialog id="search-dialog" aria-labelledby="search-title">
<div class="dialog-top">
<h2 id="search-title">想找点什么？</h2>
<form method="dialog">
<button class="close" aria-label="关闭搜索">×</button>
</form>
</div>
<label class="field-label" for="site-search">搜索页面、项目和笔记</label>
<input id="site-search" type="search" placeholder="试试 memory、Clipplane、上下文" autocomplete="off" />
<p id="search-count" role="status" class="small-status">
</p>
<div class="search-results">{searchItems.map(item=>
<a data-search-item href={item.url}>{item.title}<span aria-hidden="true">→</span>
</a>)}</div>
<p id="search-empty" hidden>暂时没有结果，换一个关键词试试。</p>
</dialog>
<script>import '../scripts/personal-space.js';</script>
</body>
</html>
