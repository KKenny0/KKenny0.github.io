---
import BaseLayout from "../layouts/BaseLayout.astro";
import { practices, projects } from "../data/projects";
import { writings } from "../data/writings";
const currentProject = projects.find((project) => project.slug === "clipplane")!;
---

<BaseLayout>
  <section class="studio-hero">
    <div class="hero-intro">
      <span class="eyebrow">Kenny Ponders · Shenzhen</span>
      <h1>I make tools for the parts of thinking that usually disappear.</h1>
    </div>
    <figure class="hero-practice-mark" aria-hidden="true">
      <img src="/assets/img/practices/walk.png" alt="" width="1254" height="1254" />
      <figcaption>thinking in motion</figcaption>
    </figure>
    <div class="hero-aside">
      <p>AI engineer working across local-first memory, agent workflows, and visual forms for thought.</p>
      <div class="now-note"><span>Now</span><strong>Shipping Clipplane and studying what deserves to persist.</strong></div>
    </div>
    <div class="hero-margin" aria-hidden="true">
      <span>capture</span><span>think</span><span>make</span>
    </div>
  </section>

  <section class="practice-section" aria-labelledby="practice-title">
    <header class="section-intro">
      <span class="section-number">01</span>
      <div><h2 id="practice-title">Three recurring practices</h2><p>Not a pipeline. Three ways of noticing where human and machine work breaks down.</p></div>
    </header>
    <div class="practice-workbench">
      <div class="practice-tabs" role="tablist" aria-label="Practices">
        {practices.map((practice, index) => (
          <button
            type="button"
            role="tab"
            class:list={["practice-tab", index === 0 && "active"]}
            aria-selected={index === 0 ? "true" : "false"}
            data-practice-tab={practice.id}
          >
            <span>{practice.index}</span><strong>{practice.title}</strong><small>{practice.description}</small>
          </button>
        ))}
      </div>
      <div class="practice-panels">
        {practices.map((practice, index) => (
          <div class="practice-panel" data-practice-panel={practice.id} hidden={index !== 0}>
            <span class="margin-label">Projects in this practice</span>
            {projects.filter((project) => project.practice === practice.id).map((project) => (
              <a href={project.url} target="_blank" rel="noopener">
                <strong>{project.name}</strong><span>{project.thesis}</span><small>{project.status} ↗</small>
              </a>
            ))}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="flagship-section" aria-labelledby="flagship-title">
    <header class="section-intro">
      <span class="section-number">02</span>
      <div><h2 id="flagship-title">Current field work</h2><p>Three projects, three different kinds of evidence.</p></div>
    </header>

    <article class="case-study case-clipplane">
      <div class="case-copy">
        <span class="case-index">A · Local-first product</span>
        <h3>Clipplane</h3>
        <p class="case-thesis">Keep web clips on your machine first.</p>
        <p>Clipplane saves pages and selections to a local org-mode inbox, keeps an inspectable capture trail, and only sends content outward when you explicitly choose a sync target.</p>
        <dl><div><dt>Boundary</dt><dd>Local save always completes first</dd></div><div><dt>Artifact</dt><dd>Human-readable inbox + machine-readable trail</dd></div><div><dt>Status</dt><dd>{currentProject.status}</dd></div></dl>
        <a class="text-link" href={currentProject.url} target="_blank" rel="noopener">Inspect Clipplane ↗</a>
      </div>
      <figure class="clipplane-artifact">
        <img src="/assets/img/projects/clipplane-settings.png" alt="Clipplane capture history showing local and synced clips" width="1600" height="900" />
        <img class="clipplane-popup" src="/assets/img/projects/clipplane-popup.png" alt="Clipplane browser extension popup" width="640" height="720" loading="lazy" />
        <figcaption>Capture history stays visible and local.</figcaption>
      </figure>
    </article>

    <article class="case-study case-tracework" id="tracework-case">
      <div class="tracework-artifact">
        <img src="/assets/img/projects/tracework-decision-ledger.webp" alt="Tracework decision replay ledger showing a decision, rejected alternative, supporting evidence, and report outputs" width="1600" height="1000" loading="lazy" />
        <pre aria-label="Tracework decision query example"><code><span>$</span> /tracework:query why did we choose local-first storage?

decision: keep the raw evidence inspectable
rejected: cloud-only session history
evidence: capture boundary + privacy promise</code></pre>
      </div>
      <div class="case-copy">
        <span class="case-index">B · Decision replay</span>
        <h3>Tracework</h3>
        <p class="case-thesis">Git remembers the change. Tracework remembers why.</p>
        <p>Session signals become cited decisions, daily reports, weekly synthesis, monthly review, and a narrative roadmap that can be questioned later.</p>
        <a class="text-link" href="https://github.com/KKenny0/Tracework" target="_blank" rel="noopener">Inspect Tracework ↗</a>
      </div>
    </article>

    <article class="case-study case-card">
      <div class="case-copy">
        <span class="case-index">C · Visual systems</span>
        <h3>card-skill</h3>
        <p class="case-thesis">Content in, checked visual artifacts out.</p>
        <p>The layout changes with the argument. Posters, infographics, editorial covers, and reading cards are different forms, not color variants of one template.</p>
        <a class="text-link" href="https://github.com/KKenny0/card-skill" target="_blank" rel="noopener">Inspect card-skill ↗</a>
      </div>
      <div class="card-gallery" aria-label="card-skill output gallery">
        <figure><img src="/assets/img/projects/card-poster.webp" alt="Poster generated by card-skill" loading="lazy" /><figcaption>Poster</figcaption></figure>
        <figure><img src="/assets/img/projects/card-infograph.webp" alt="Infographic generated by card-skill" loading="lazy" /><figcaption>Infograph</figcaption></figure>
        <figure><img src="/assets/img/projects/card-editorial.webp" alt="Editorial image generated by card-skill" loading="lazy" /><figcaption>Editorial</figcaption></figure>
      </div>
    </article>
  </section>

  <section class="notes-preview" aria-labelledby="notes-title">
    <header class="section-intro">
      <span class="section-number">03</span>
      <div><h2 id="notes-title">Field notes</h2><p>Source-level writing on context, memory, and agent design.</p></div>
    </header>
    <div class="note-rows">
      {writings.articles.slice(0, 4).map((article, index) => (
        <a href={article.url} target="_blank" rel="noopener"><span>0{index + 1}</span><strong>{article.title}</strong><small>{article.date} · {article.source}</small></a>
      ))}
    </div>
    <a class="section-link" href="/notes/">All notes →</a>
  </section>

  <section class="home-about">
    <span class="section-number">04</span>
    <p>I work between research and product engineering: language systems, multimodal workflows, local-first tools, and the small interfaces that make agent work more humane.</p>
    <div><a href="/about/">Background and selected work →</a><a href="mailto:jdlow@live.cn">Compare notes ↗</a></div>
  </section>
</BaseLayout>

<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-practice-tab]"));
  const panels = Array.from(document.querySelectorAll<HTMLElement>("[data-practice-panel]"));
  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const id = tab.dataset.practiceTab;
      tabs.forEach((item) => {
        const selected = item === tab;
        item.classList.toggle("active", selected);
        item.setAttribute("aria-selected", String(selected));
      });
      panels.forEach((panel) => { panel.hidden = panel.dataset.practicePanel !== id; });
    });
  });
</script>
