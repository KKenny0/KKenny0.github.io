---
import SpaceLayout from '../layouts/SpaceLayout.astro';
import SpaceApp from './space/SpaceApp';
import '../styles/proto-workbench.css';
import '../styles/collage-inner.css';
import {projects} from '../data/projects';
import {routePath} from '../lib/space-routes';
const {lang,route:entry}=Astro.props;
const isIndex=['projects','notes'].some(view=>Astro.url.pathname.replace(/\/$/,'')===`${lang==='zh'?'/zh':''}/${view}`);
const route=isIndex?{view:entry.view}:entry;
---
<SpaceLayout lang={lang} route={route}>
  {['notes','projects'].includes(route.view)&&<Fragment>
    <script is:inline>
      const spaceQuery = new URLSearchParams(location.search);
      if (spaceQuery.has('from') || spaceQuery.has('topic')) document.documentElement.dataset.spaceQuery = '';
    </script>
    <style is:inline>
      [data-space-query] .formal-space:not([data-space-ready]) :is(
        .pb-back, .pb-language, .space-writing-detail [data-space-return], .space-work [data-story-link]
      ) { visibility: hidden; }
      [data-space-query] .formal-space:not([data-space-ready]) .space-index > :not(.space-heading) { display: none; }
      .space-query-status { display: none; }
      [data-space-query] .formal-space:not([data-space-ready]) .space-query-status { display: block; }
    </style>
  </Fragment>}
  <SpaceApp client:load locale={lang} initialRoute={route}/>
  <noscript><nav class="static-options" aria-label={lang==='zh'?'语言与更多入口':'Language and more'}>
    <a href={routePath(route,lang==='zh'?'en':'zh')}>{lang==='zh'?'English':'中文'}</a>
    <a href={`${lang==='zh'?'/zh':''}/projects/`}>{lang==='zh'?'全部项目':'All projects'}</a>
    <a href={`${lang==='zh'?'/zh':''}/notes/`}>{lang==='zh'?'全部观察':'All observations'}</a>
    <a href={`${lang==='zh'?'/zh':''}/about/`}>{lang==='zh'?'关于 Kenny':'About Kenny'}</a>
    {route.view==='projects'&&<details><summary>{lang==='zh'?'归档项目':'Archived projects'}</summary>{projects.filter(p=>p.archived).map(p=><a id={p.slug} href={routePath({view:'projects',item:p.slug},lang)}>{p.name}</a>)}</details>}
  </nav></noscript>
</SpaceLayout>
